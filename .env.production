# Production build configuration, committed on purpose.
#
# These two values live here rather than in the Pages project settings because
# the settings API silently dropped them: a PATCH sending
# deployment_configs.production.env_vars returned success and stored nothing in
# production (the value surfaced under `preview` instead). Configuration that the
# API will not persist belongs in the repository, where it is versioned, reviewable
# and applied by every build — the same reasoning that moved the Pages build
# configuration into wrangler.toml.
#
# Neither value is a secret: the mode is a flag and the origin is a public
# hostname. Anything that IS secret never appears in this file (rule R2).
#
# VITE_API_MODE=live switches the console from bundled fixtures to the real API.
# VITE_API_BASE empty means same-origin: the console calls /api/... on its own
# Pages hostname and functions/api/[[path]].ts proxies to the Worker, forwarding
# the Cloudflare Access assertion header.
VITE_API_MODE=live
VITE_API_BASE=
