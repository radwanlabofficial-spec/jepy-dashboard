# Frontend environment
#
# VITE_API_BASE - base URL of the Jepy Worker API.
#   Leave it empty (or unset) to run the console against bundled demo fixtures.
#   Set it to the deployed Worker origin to talk to the real API.
#
# There are deliberately no secrets here: the browser bundle carries zero
# credentials (rule R2). Authentication is entirely Cloudflare Access, which
# rides on the Access cookie via `credentials: 'include'`.
VITE_API_BASE=
